{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node --experimental-strip-types --import ./tests/register-loader.mjs --test tests/*.test.mjs",
    "data:check": "node scripts/archive_manifest.mjs && node --experimental-strip-types scripts/check_archive.mjs",
    "data:repair": "node --experimental-strip-types scripts/repair_archive.mjs --apply",
    "prebuild": "npm run data:check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@cloudflare/workers-types": "5.20260826.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.126.0"
  },
  "type": "module"
}
